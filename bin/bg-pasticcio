#!/bin/bash

# bg-pasticcio — worker for the Omarchy background-rotation plugin.
#
# Fetches a JSON document from a configurable endpoint, downloads the image it
# points at and applies it as the desktop background. Nothing is cached: the
# images the user kept are the only ones on disk, and the only thing to fall
# back on when the endpoint cannot be reached.
#
# Usage: bg-pasticcio [run|next|like|dislike|enable|disable|restore|...]
#
#   run                   fetch a fresh image and apply it; falls back to `next`
#   next                  show the next image you kept (no network)
#   like                  keep the current image for good
#   dislike               never show the current image again, and replace it now
#   enable                allow the plugin to change the background
#   disable               stop it, and put the original background back
#   restore               put the background from before the first change back
#   set-config KEY VALUE  change one setting in config.env (VALUE may instead
#                         be given as a line on stdin, which keeps a secret out
#                         of the process's command line)
#   status                print JSON describing config, images and last run
#   interval              print the configured interval in minutes
#
# Nothing here touches the background until BG_ENABLED is turned on: the plugin
# is installed off, and the wallpaper it finds in place is remembered before it
# replaces it, so `restore` can always put things back.
#
# Deliberately not `set -e`: every failure is handled and downgraded to the
# offline rotation path, because a wallpaper that stops changing is the bug we
# are trying to avoid.

set -uo pipefail

# Every path below is compared, sooner or later, against the background symlink
# after `readlink -f` has resolved it, so the paths have to be resolved too.
# With ~/.local/share (or $HOME) a symlink, an unresolved prefix matches
# nothing: every image of ours reads as foreign, so nothing can be kept,
# discard_unkept deletes the wallpaper on screen, and the background recorded
# as "the one from before" is one of ours. -m rather than -f because none of
# these exist yet on a first run.
canonical_path() {
  readlink -m -- "$1" 2>/dev/null || printf '%s\n' "$1"
}

CONFIG_DIR=$(canonical_path "${XDG_CONFIG_HOME:-$HOME/.config}/bg-pasticcio")
CONFIG_FILE="$CONFIG_DIR/config.env"
CONFIG_LOCK="$CONFIG_DIR/.config-lock"
DATA_DIR=$(canonical_path "${XDG_DATA_HOME:-$HOME/.local/share}/bg-pasticcio")
IMAGE_DIR="$DATA_DIR/images"
LIKED_DIR="$DATA_DIR/liked"
STATE_DIR=$(canonical_path "${XDG_STATE_HOME:-$HOME/.local/state}/bg-pasticcio")
LOG_FILE="$STATE_DIR/bg-pasticcio.log"
LOCK_FILE="$STATE_DIR/lock"
LAST_FILE="$STATE_DIR/last"
BLOCKLIST_FILE="$STATE_DIR/blocklist"
NOTICE_IMAGE="$STATE_DIR/setup-required.png"
ORIGINAL_FILE="$STATE_DIR/original-background"

OMARCHY_STATE=$(canonical_path "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy")
CURRENT_LINK="$OMARCHY_STATE/current/background"

# Works out of the box: a CC0 wallpaper feed that also sends title, creator and
# licence. Blank it in config.env to rotate only the images you kept.
DEFAULT_ENDPOINT="https://bg.ssimo.dev"

LOG_MAX_BYTES=262144
LOG_KEEP_LINES=200

# A wallpaper is a few megabytes; anything wildly larger is a mistake or a
# hostile endpoint trying to fill the disk, and curl stops rather than storing
# it.
MAX_DOWNLOAD_BYTES=$((64 * 1024 * 1024))

# The JSON answer is a few hundred bytes and is read into a shell variable, so
# it gets a cap of its own rather than the wallpaper's: at the image limit an
# endpoint could drive this process to hundreds of megabytes before jq ever
# looked at what it sent.
MAX_JSON_BYTES=$((256 * 1024))

# Redirects are followed by hand (see curl_with_backoff), so the ceiling is
# ours to set rather than curl's.
MAX_REDIRECTS=5

# Everything the worker cannot do without. Checked once, so a missing package
# says so in the log instead of failing somewhere deep in a pipeline.
REQUIRED_COMMANDS=(curl jq file sha256sum flock find getent)

# Same extension set Omarchy itself accepts for backgrounds.
FIND_EXT=(-iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png'
  -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp')

# --------------------------------------------------------------- temp files
#
# Every scratch file this worker writes carries its pid, so a run can clean up
# after itself — none of them is an image, so discard_unkept cannot see them,
# and a 64 MB half-download left behind stays there for good otherwise.

cleanup_temp_files() {
  rm -f -- \
    "$IMAGE_DIR/.download.$$" \
    "$STATE_DIR/.curl-body.$$" \
    "$STATE_DIR/.curl-err.$$" \
    "$CONFIG_DIR/.config.env.$$" \
    "$LOG_FILE.tmp.$$" \
    "$BLOCKLIST_FILE.tmp.$$" 2>/dev/null
  return 0
}

# INT and TERM exit rather than resuming, which is what gets the EXIT trap run.
trap cleanup_temp_files EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# A process killed outright — SIGKILL, a lost session, the power going — never
# runs the trap above, so sweep what an earlier run left. An hour is far longer
# than any transfer this worker waits for.
sweep_stale_temp_files() {
  find "$IMAGE_DIR" "$STATE_DIR" "$CONFIG_DIR" -maxdepth 1 -type f \
    \( -name '.download.*' -o -name '.curl-body.*' -o -name '.curl-err.*' \
    -o -name '.config.env.*' -o -name '*.tmp.*' \) \
    -mmin +60 -delete 2>/dev/null
  return 0
}

# ------------------------------------------------------------------ logging

log() {
  local line
  printf -v line '%s %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
  printf '%s\n' "$line" >>"$LOG_FILE" 2>/dev/null
  [[ -t 2 ]] && printf '%s\n' "$line" >&2
  return 0
}

rotate_log() {
  local size
  size=$(stat -c %s "$LOG_FILE" 2>/dev/null) || return 0
  ((size > LOG_MAX_BYTES)) || return 0
  local tmp="$LOG_FILE.tmp.$$"
  tail -n "$LOG_KEEP_LINES" "$LOG_FILE" >"$tmp" 2>/dev/null &&
    mv -f "$tmp" "$LOG_FILE"
  rm -f "$tmp"
}

# The optional second field is a sentence for the panel to show. The enum in
# the first field stays machine-readable so callers can branch on it.
record_result() {
  printf '%s\t%s\t%s\n' "$(date +%s)" "$1" "${2:-}" >"$LAST_FILE" 2>/dev/null
  return 0
}

# ------------------------------------------------------------------- config

# The endpoint can carry a token — that is why it is kept out of the log — so
# the file holding it is created owner-only, in a subshell so the umask goes
# back afterwards and nothing else picks up the narrower mode. Set on creation
# rather than chmod'd after, so there is no moment where the file exists and is
# readable by anyone else.
write_default_config() (
  umask 077
  # Two parts, because the endpoint is written from $DEFAULT_ENDPOINT while the
  # rest is a quoted heredoc: one place to change the default, and no risk of
  # the shell expanding something in the comments.
  cat >"$CONFIG_FILE" <<'EOF'
# bg-pasticcio — configuration.
# Edit freely; changes to BG_ENABLED and BG_INTERVAL_MINUTES are picked up
# without a restart.

# Whether the plugin may change your background at all. It ships off: nothing
# is touched until you turn this on, from the panel in the bar or with
# `bg-pasticcio enable`. Turning it off again puts your original background
# back, if it is still on disk.
BG_ENABLED=0

# Endpoint returning JSON shaped like {"url": "https://.../image.jpg"}, and
# optionally a title, creator and licence for it.
# Leave empty to rotate only the images you kept.
EOF
  printf 'BG_ENDPOINT="%s"\n' "$DEFAULT_ENDPOINT" >>"$CONFIG_FILE"
  cat >>"$CONFIG_FILE" <<'EOF'

# How often to change the background, in minutes.
BG_INTERVAL_MINUTES=60

# Per-request network timeout, in seconds.
BG_TIMEOUT_SECONDS=20

# Attempts per network call before giving up and showing a kept image instead.
BG_MAX_RETRIES=4

# Exponential backoff base: waits BASE, BASE*2, BASE*4 ... between attempts.
BG_RETRY_BASE_SECONDS=2

# How many times to ask the endpoint again when it answers with an image you
# have already disliked. An endpoint that caches its answer will keep handing
# back the same one, so this gives up quickly and shows a kept image instead.
BG_BLOCKED_RETRIES=3
EOF
)

CONFIG_KEYS=(BG_ENABLED BG_ENDPOINT BG_INTERVAL_MINUTES
  BG_TIMEOUT_SECONDS BG_MAX_RETRIES BG_RETRY_BASE_SECONDS BG_BLOCKED_RETRIES)

load_config() {
  mkdir -p "$CONFIG_DIR" "$IMAGE_DIR" "$LIKED_DIR" "$STATE_DIR" 2>/dev/null

  # Narrowed on every run, not only at creation: a config written before this
  # existed is already 0644, and so is a blocklist — which records the source
  # URL of every image discarded, and those can be presigned.
  chmod 0700 -- "$CONFIG_DIR" 2>/dev/null
  [[ -f $CONFIG_FILE ]] && chmod 0600 -- "$CONFIG_FILE" 2>/dev/null
  [[ -f $BLOCKLIST_FILE ]] && chmod 0600 -- "$BLOCKLIST_FILE" 2>/dev/null

  # Anything already in the environment wins over the config file, which makes
  # `BG_ENDPOINT=... bg-pasticcio run` usable for testing without editing config.
  local key
  declare -A env_override=()
  for key in "${CONFIG_KEYS[@]}"; do
    [[ -v $key ]] && env_override[$key]=${!key}
  done

  BG_ENABLED=0
  BG_ENDPOINT="$DEFAULT_ENDPOINT"
  BG_INTERVAL_MINUTES=60
  BG_TIMEOUT_SECONDS=20
  BG_MAX_RETRIES=4
  BG_RETRY_BASE_SECONDS=2
  BG_BLOCKED_RETRIES=3

  if [[ ! -f $CONFIG_FILE ]]; then
    write_default_config && log "created default config at $CONFIG_FILE"
  fi

  if [[ -f $CONFIG_FILE ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONFIG_FILE" 2>/dev/null || log "WARN could not parse $CONFIG_FILE, using defaults"
    set +a
  fi

  for key in "${!env_override[@]}"; do
    printf -v "$key" '%s' "${env_override[$key]}"
  done

  # A hand-edited file may say true/yes/on; the rest of the script only ever
  # sees 0 or 1, and anything unrecognisable means off.
  is_truthy "$BG_ENABLED" && BG_ENABLED=1 || BG_ENABLED=0

  # A malformed number must not turn into an infinite loop or a zero interval.
  is_positive_int "$BG_INTERVAL_MINUTES" || BG_INTERVAL_MINUTES=60
  is_positive_int "$BG_TIMEOUT_SECONDS" || BG_TIMEOUT_SECONDS=20
  is_positive_int "$BG_MAX_RETRIES" || BG_MAX_RETRIES=4
  is_positive_int "$BG_RETRY_BASE_SECONDS" || BG_RETRY_BASE_SECONDS=2
  is_positive_int "$BG_BLOCKED_RETRIES" || BG_BLOCKED_RETRIES=3
}

check_dependencies() {
  local missing=() tool
  for tool in "${REQUIRED_COMMANDS[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  ((${#missing[@]} == 0)) && return 0
  log "ERROR missing required command(s): ${missing[*]}"
  return 1
}

is_positive_int() {
  [[ ${1:-} =~ ^[0-9]+$ ]] && ((${1} > 0))
}

is_truthy() {
  case "${1,,}" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

is_falsy() {
  case "${1,,}" in
    0 | false | no | off) return 0 ;;
    *) return 1 ;;
  esac
}

# config.env is `source`d by this script, so a value typed into the panel
# reaches bash as code. Anything that could end the quoting or start a
# substitution is refused outright rather than escaped.
config_value_safe() {
  case ${1-} in
    *'"'* | *'$'* | *'`'* | *'\'* | *$'\n'* | *$'\r'*) return 1 ;;
  esac
  return 0
}

config_value_valid() {
  local key=$1 value=${2-}
  case "$key" in
    BG_ENABLED)
      is_truthy "$value" || is_falsy "$value"
      ;;
    BG_ENDPOINT)
      [[ -z $value ]] && return 0
      local url_re='^https?://[A-Za-z0-9._~:/?#@!&'"'"'()*+,;=%-]+$'
      [[ $value =~ $url_re ]]
      ;;
    *) is_positive_int "$value" ;;
  esac
}

# ------------------------------------------------------------------ images
#
# There is no cache. $IMAGE_DIR holds at most one file — the downloaded image
# currently on screen — and discard_unkept below is what keeps it at one.
# $LIKED_DIR is the only collection that survives a run: nothing in this file
# ever deletes from it, and it is the whole of what a failed fetch falls back
# on.

files_in() {
  find "$@" -maxdepth 1 -type f \( "${FIND_EXT[@]}" \) -print0 2>/dev/null | sort -z
}

liked_files_sorted() { files_in "$LIKED_DIR"; }

count_files() {
  local -a files
  mapfile -d '' -t files < <("$@")
  printf '%s\n' "${#files[@]}"
}

current_background() {
  readlink -f "$CURRENT_LINK" 2>/dev/null
}

# Where an image sits decides what the panel may offer for it: "downloaded" can
# be liked, "liked" can only be disliked, anything else is not ours to judge.
image_origin() {
  local image=${1:-}
  [[ -n $image && -f $image ]] || return 1
  case "$image" in
    "$LIKED_DIR"/*) printf 'liked\n' ;;
    "$IMAGE_DIR"/*) printf 'downloaded\n' ;;
    *) printf 'foreign\n' ;;
  esac
}

bg_set_bin() {
  if command -v omarchy-theme-bg-set >/dev/null 2>&1; then
    printf 'omarchy-theme-bg-set\n'
    return 0
  fi
  local candidate
  for candidate in \
    "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-theme-bg-set" \
    "$HOME/.local/share/omarchy/bin/omarchy-theme-bg-set"; do
    if [[ -x $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# The background in place before this plugin ever changed it, so uninstalling
# can leave the desktop as it was found. Written once, from apply_background
# below — the one point every path that changes the wallpaper goes through.
#
# Two fields: the resolved file, and the raw symlink target. Omarchy points the
# symlink at "current/theme/backgrounds/...", which is itself a symlink that
# follows the active theme, so the resolved path is the honest answer and the
# target is the fallback for a file that moved with a theme update.
remember_original_background() {
  [[ -e $ORIGINAL_FILE ]] && return 0

  local resolved target origin
  resolved=$(readlink -f -- "$CURRENT_LINK" 2>/dev/null)
  target=$(readlink -- "$CURRENT_LINK" 2>/dev/null)

  # Never record one of ours: a downloaded image, a kept one, or our own notice.
  if [[ -n $resolved ]]; then
    origin=$(image_origin "$resolved") || origin="none"
    if [[ $origin == downloaded || $origin == liked || $resolved == "$NOTICE_IMAGE" ]]; then
      resolved=""
      target=""
    fi
  fi

  # Written even when both fields are empty — there simply was no background to
  # remember, and the file existing is what stops us looking again later.
  printf '%s\t%s\n' "$resolved" "$target" >"$ORIGINAL_FILE" 2>/dev/null
  [[ -n $resolved ]] && log "remembered the background that was in place: $resolved"
  return 0
}

# Prints the path `restore` would put back, or nothing when there is none left.
original_background() {
  [[ -f $ORIGINAL_FILE ]] || return 1
  local resolved target
  IFS=$'\t' read -r resolved target <"$ORIGINAL_FILE"
  if [[ -n $resolved && -f $resolved ]]; then
    printf '%s\n' "$resolved"
    return 0
  fi
  if [[ -n $target && -f $target ]]; then
    printf '%s\n' "$target"
    return 0
  fi
  return 1
}

apply_background() {
  local image=$1 setter output rc
  remember_original_background
  if ! setter=$(bg_set_bin); then
    log "ERROR omarchy-theme-bg-set not found; is Omarchy installed?"
    return 1
  fi
  output=$("$setter" "$image" 2>&1)
  rc=$?
  if ((rc != 0)); then
    log "ERROR failed to apply $(basename -- "$image"): ${output:-exit $rc}"
    return 1
  fi
  log "applied $(basename -- "$image")"
  return 0
}

# Rotate to the next kept image after the one currently in use, wrapping
# around. This is the whole offline story: with $LIKED_DIR empty there is
# nothing to fall back on, and the background is left exactly as it is.
#
# The optional argument is a path to leave out, which is how a dislike avoids
# rotating straight back onto the image it is in the middle of removing.
rotate_liked() {
  local exclude=${1:-}
  local -a images=()
  local file
  while IFS= read -r -d '' file; do
    [[ -n $exclude && $file == "$exclude" ]] && continue
    images+=("$file")
  done < <(liked_files_sorted)

  local total=${#images[@]}
  if ((total == 0)); then
    log "no kept images to fall back on, leaving the background untouched"
    return 1
  fi

  local current index=-1 i
  current=$(current_background)
  for i in "${!images[@]}"; do
    if [[ ${images[$i]} == "$current" ]]; then
      index=$i
      break
    fi
  done

  local next=$(((index + 1) % total))
  apply_background "${images[$next]}"
}

# --------------------------------------------------------------- ratings
#
# A dislike has to outlive the file it is about, so the blocklist keys on the
# content hash (and the URL, when we know it) rather than on the path. Image
# file names only carry the first 8 hex digits; these rows carry all of it.

image_hash() {
  local sum
  sum=$(sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1) || return 1
  [[ -n $sum ]] || return 1
  printf '%s\n' "$sum"
}

is_blocked_hash() {
  [[ -n ${1:-} && -f $BLOCKLIST_FILE ]] || return 1
  cut -f1 -- "$BLOCKLIST_FILE" 2>/dev/null | grep -qxF -- "$1"
}

is_blocked_url() {
  [[ -n ${1:-} && -f $BLOCKLIST_FILE ]] || return 1
  cut -f2 -- "$BLOCKLIST_FILE" 2>/dev/null | grep -qxF -- "$1"
}

block_image() {
  local hash=$1 url=${2:-}
  is_blocked_hash "$hash" && return 0
  printf '%s\t%s\t%s\n' "$hash" "$url" "$(date +%s)" >>"$BLOCKLIST_FILE" 2>/dev/null
  # Source URLs, so owner-only like the config. Cheap enough to repeat: the
  # append above creates the file the first time round.
  chmod 0600 -- "$BLOCKLIST_FILE" 2>/dev/null
  return 0
}

# Only used to undo a dislike that could not be carried out, so the blocklist
# never claims to have removed an image that is still on screen.
unblock_image() {
  local hash=$1 tmp="$BLOCKLIST_FILE.tmp.$$"
  [[ -f $BLOCKLIST_FILE ]] || return 0
  awk -F'\t' -v h="$hash" '$1 != h' "$BLOCKLIST_FILE" >"$tmp" 2>/dev/null &&
    mv -f -- "$tmp" "$BLOCKLIST_FILE"
  rm -f -- "$tmp"
  return 0
}

blocked_count() {
  local n=0
  [[ -f $BLOCKLIST_FILE ]] && n=$(grep -c '' -- "$BLOCKLIST_FILE" 2>/dev/null)
  printf '%s\n' "${n:-0}"
}

# ----------------------------------------------------------- notice image
#
# With nothing to show there is nothing to show, and a silent no-op looks like
# a broken plugin. Put the explanation on the wallpaper itself. The notice
# lives outside both directories, so it is never rotated into and never deleted.

screen_geometry() {
  local geometry
  geometry=$(hyprctl -j monitors 2>/dev/null |
    jq -r 'map(select(.width and .height)) | max_by(.width * .height)
           | "\(.width)x\(.height)"' 2>/dev/null)
  [[ $geometry =~ ^[0-9]+x[0-9]+$ ]] || geometry="1920x1080"
  printf '%s\n' "$geometry"
}

# The generic sans-serif alias is whatever the system already considers its
# readable sans, and fontconfig always resolves it — no font list to keep in
# sync. Asking for the font *file* also sidesteps ImageMagick's own font-name
# table, which is built at compile time and often does not list what is
# installed. This is the same lookup omarchy-shell uses for its own UI font.
resolve_font() {
  command -v fc-match >/dev/null 2>&1 || return 1
  local file
  file=$(fc-match -f '%{file}' sans-serif 2>/dev/null)
  [[ -n $file && -f $file ]] || return 1
  printf '%s\n' "$file"
}

render_notice() {
  local body=$1
  if ! command -v magick >/dev/null 2>&1; then
    log "ERROR cannot draw the notice: imagemagick (magick) is missing"
    return 1
  fi

  local geometry width height
  geometry=$(screen_geometry)
  width=${geometry%x*}
  height=${geometry#*x}

  local -a font=()
  local file
  file=$(resolve_font) && font=(-font "$file")

  local column=$((width * 4 / 5))

  magick -size "$geometry" canvas:black \
    \( -background none -fill white -gravity center "${font[@]}" \
    -size "${column}x" -pointsize "$((height / 32))" \
    -interline-spacing "$((height / 60))" caption:"$body" \) \
    -gravity center -composite "$NOTICE_IMAGE" 2>>"$LOG_FILE" || {
    log "ERROR could not render the notice"
    return 1
  }
  return 0
}

show_notice() {
  render_notice "$1" || return 1
  apply_background "$NOTICE_IMAGE"
}

setup_notice_body() {
  # ~ keeps the path readable; the full path can be wider than the text column.
  cat <<EOF
No image endpoint is configured yet.

Edit ${CONFIG_FILE/#$HOME/\~}
and set BG_ENDPOINT to a URL returning

{"url": "https://example.com/image.jpg"}

Then run  omarchy-shell bgpasticcio next
to change the background right away.
EOF
}

empty_notice_body() {
  cat <<'EOF'
That image is gone and you have not kept any others.

The next scheduled run will fetch a new one, or open the
bg-pasticcio panel in the bar and pick "Next" to
try the endpoint right now.
EOF
}

show_setup_notice() {
  show_notice "$(setup_notice_body)"
}

# Nothing downloaded is worth keeping unless the user said so, and the one on
# screen is the single exception — deleting it would leave the desktop pointing
# at a file that is gone. $LIKED_DIR is not scanned here at all: liking an image
# is precisely how it stops being subject to this.
#
# Called once from main() after every command that takes the lock, so the
# invariant — at most one file in $IMAGE_DIR — holds whatever the command did.
discard_unkept() {
  local current file
  current=$(current_background)
  while IFS= read -r -d '' file; do
    [[ $file == "$current" ]] && continue
    rm -f -- "$file" "$file.src" "$file.meta" && log "discarded $(basename -- "$file")"
  done < <(files_in "$IMAGE_DIR")
}

# ----------------------------------------------------------------- network

# Whether an address is one a fetch is allowed to reach: not this machine, not
# the LAN, not a link-local, CGNAT or multicast address.
is_public_address() {
  case "${1:-}" in
    # IPv4: unspecified, private, loopback, link-local, CGNAT, and everything
    # from the multicast range upwards.
    '' | 0.* | 10.* | 127.* | 169.254.* | 192.168.*) return 1 ;;
    172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) return 1 ;;
    100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) return 1 ;;
    22[4-9].* | 2[34][0-9].* | 25[0-5].*) return 1 ;;
    # IPv6: unspecified, loopback, IPv4-mapped, unique-local (fc00::/7),
    # link-local (fe80::/10), multicast (ff00::/8).
    :: | ::1 | ::[fF][fF][fF][fF]:*) return 1 ;;
    [fF][cCdD][0-9a-fA-F][0-9a-fA-F]:*) return 1 ;;
    [fF][eE][89abAB][0-9a-fA-F]:*) return 1 ;;
    [fF][fF][0-9a-fA-F][0-9a-fA-F]:*) return 1 ;;
  esac
  return 0
}

# The host of a URL, without userinfo, port or the brackets around a literal
# IPv6 address. Empty for a URL that has no host at all.
url_host() {
  local rest=${1#*://}
  rest=${rest%%/*}
  rest=${rest%%\?*}
  rest=${rest%%#*}
  rest=${rest##*@}
  if [[ $rest == \[*\]* ]]; then
    rest=${rest#\[}
    printf '%s' "${rest%%\]*}"
    return 0
  fi
  printf '%s' "${rest%%:*}"
}

# The port a URL connects on, so a pinned address is pinned to the right one.
# Explicit port wins; otherwise the scheme's default.
url_port() {
  local url=$1 scheme rest port=""
  scheme=${url%%://*}
  rest=${url#*://}
  rest=${rest%%/*}
  rest=${rest%%\?*}
  rest=${rest%%#*}
  rest=${rest##*@}
  if [[ $rest == \[*\]* ]]; then
    port=${rest#*\]}
  elif [[ $rest == *:* ]]; then
    port=:${rest##*:}
  fi
  port=${port#:}
  if [[ $port =~ ^[0-9]+$ ]]; then
    printf '%s' "$port"
  elif [[ ${scheme,,} == https ]]; then
    printf '443'
  else
    printf '80'
  fi
}

# What a URL may be built from before curl is allowed near it. The URL reaches
# curl through its config-file syntax now (see curl_with_backoff), which quotes
# with " and \, so a URL carrying either could add options of its own — and the
# endpoint picks the image URL, and through a redirect every hop after the
# first. The set is the union of the two already in use: what
# config_value_valid accepts for BG_ENDPOINT, and what sanitize_meta accepts
# for a credit link.
URL_SAFE_RE='^https?://[A-Za-z0-9._~:/?#@!$&'"'"'()*+,;=%-]+$'

url_is_safe() {
  [[ ${1:-} =~ $URL_SAFE_RE ]]
}

# The endpoint picks the image URL, and a redirect lets it pick again after the
# first hop, so every address a hop resolves to has to be a public one.
# Otherwise a feed could have this machine fetch from something only this
# machine can reach — a service on loopback, a box on the LAN.
#
# Checking the name and then letting curl look it up again would leave a gap:
# a name whose owner controls the DNS answer can hand out a public address here
# and a loopback one to curl a moment later. So the addresses that passed are
# kept in RESOLVED_ADDRS and curl is pinned to exactly those with --resolve —
# what was vetted is what gets connected to, and no second lookup happens.
RESOLVED_ADDRS=()

url_is_public() {
  local url=$1 host addr
  RESOLVED_ADDRS=()
  host=$(url_host "$url")
  if [[ -z $host ]]; then
    log "ERROR refusing a url with no host"
    return 1
  fi
  while read -r addr _; do
    [[ -n $addr ]] || continue
    if ! is_public_address "$addr"; then
      log "ERROR refusing $host: it resolves to the non-public address $addr"
      RESOLVED_ADDRS=()
      return 1
    fi
    # getent lists an address once per socket type; curl wants each one once.
    [[ " ${RESOLVED_ADDRS[*]} " == *" $addr "* ]] && continue
    RESOLVED_ADDRS+=("$addr")
  done < <(getent ahosts "$host" 2>/dev/null)
  ((${#RESOLVED_ADDRS[@]})) || { log "ERROR could not resolve $host"; return 1; }
  return 0
}

# The --resolve argument that pins a hop to the addresses just vetted for it.
# Prints nothing when the host is already a literal address: there is no name
# to resolve, so curl connects to the address is_public_address passed on.
resolve_pin_for() {
  local url=$1 host addr list=""
  host=$(url_host "$url")
  [[ $host == *:* || $host =~ ^[0-9.]+$ ]] && return 0
  for addr in "${RESOLVED_ADDRS[@]}"; do
    # A literal IPv6 address goes in brackets, the way curl expects it.
    [[ $addr == *:* ]] && addr="[$addr]"
    list+="${list:+,}$addr"
  done
  [[ -n $list ]] || return 0
  printf -- '--resolve\n%s:%s:%s\n' "$host" "$(url_port "$url")" "$list"
}

# curl with bounded exponential backoff. $1 is where the body goes ("-" for
# stdout), $2 the URL; a non-empty $3 says the URL is the one the user put in
# config.env, which may legitimately be a private address — a local feed of
# their own. Nothing the endpoint names afterwards gets that latitude. $4 caps
# the bytes accepted, defaulting to the wallpaper limit.
#
# -L is deliberately not used: it would connect to whatever the previous hop
# named before url_is_public could look at it, so the hops are walked here.
# Returns 6 for a hop that was refused, otherwise curl's own status.
curl_with_backoff() {
  local out=$1 url=$2 trusted=${3:-} ceiling=${4:-$MAX_DOWNLOAD_BYTES}
  local attempt=1 hop target next rc delay reason
  local -a pin=()
  local errfile="$STATE_DIR/.curl-err.$$"
  local body=$out spool=""
  [[ $out == - ]] && {
    spool="$STATE_DIR/.curl-body.$$"
    body=$spool
  }

  while :; do
    hop=0
    target=$url
    while :; do
      pin=()
      # Before anything else: BG_ENDPOINT is validated when the panel writes it
      # but not when the file is edited by hand, and a redirect target is
      # whatever a server said. The message names no URL — it can carry a token.
      if ! url_is_safe "$target"; then
        log "ERROR refusing a url that is not a plain http(s) url"
        rm -f -- "$errfile" "$spool"
        return 6
      fi
      if [[ -z $trusted || $hop -gt 0 ]]; then
        if ! url_is_public "$target"; then
          rm -f -- "$errfile" "$spool"
          return 6
        fi
        mapfile -t pin < <(resolve_pin_for "$target")
      fi
      # Explicit protocols: an endpoint must not be able to send the fetch into
      # file:// or scp://, whatever the local curl's defaults happen to be.
      # `%{stderr}` puts the next location where it cannot be mistaken for part
      # of the body; on a final response it writes nothing at all.
      # The URL goes in on stdin, through curl's config-file syntax, rather than
      # in argv: it can carry a token, and /proc/<pid>/cmdline is readable by
      # every local user unless /proc was mounted with hidepid. Everything else
      # stays in argv — the pinned addresses give away a host, never a secret.
      printf 'url = "%s"\n' "$target" | curl -fsS \
        --proto '=http,https' \
        ${pin[@]+"${pin[@]}"} \
        --max-filesize "$ceiling" \
        --max-time "$BG_TIMEOUT_SECONDS" \
        -w '%{stderr}%{redirect_url}' \
        -o "$body" -K - 2>"$errfile"
      rc=$?
      ((rc == 0)) || break
      next=$(tr -d '\r\n' <"$errfile" 2>/dev/null)
      [[ -n $next ]] || break
      if ((++hop > MAX_REDIRECTS)); then
        log "ERROR more than $MAX_REDIRECTS redirects, giving up"
        rm -f -- "$errfile" "$spool"
        return 47
      fi
      target=$next
    done

    if ((rc == 0)); then
      [[ -n $spool ]] && cat -- "$spool"
      rm -f -- "$errfile" "$spool"
      return 0
    fi
    # curl names the URL it failed on, and an endpoint URL can carry a token,
    # so keep the host and the reason out of the log's reach.
    reason=$(tail -n1 -- "$errfile" 2>/dev/null | tr -d '\r' | sed -E 's#[a-z]+://[^ ]*#<url>#g')
    : "${reason:=curl exit $rc}"
    if ((attempt >= BG_MAX_RETRIES)); then
      log "WARN gave up after $attempt attempt(s): $reason"
      rm -f -- "$errfile" "$spool"
      return "$rc"
    fi
    delay=$((BG_RETRY_BASE_SECONDS * (1 << (attempt - 1))))
    ((delay > 60)) && delay=60
    log "WARN $reason; retry $((attempt + 1))/$BG_MAX_RETRIES in ${delay}s"
    # Jitter avoids every machine on a flaky network retrying in lockstep.
    sleep "$delay.$((RANDOM % 100))"
    ((attempt++))
  done
}

# --------------------------------------------------------------- metadata
#
# An endpoint may say more about a picture than where to get it — a title, who
# made it, what licence it carries. All of it is untrusted text that ends up on
# screen, and two of the fields end up in a browser, so only a known set of
# keys survives, strings are capped, and a URL has to be http(s) built from
# characters that cannot break out of a single-quoted shell word. Dropping the
# apostrophe from that set is what makes the quoting in the panel airtight.

META_MAX_TEXT=200

sanitize_meta() {
  jq -c --argjson max "$META_MAX_TEXT" '
    def clean_text:
      # Angle brackets are stripped, not escaped: a QML Text defaults to
      # AutoText and renders anything that looks like HTML as rich text, and
      # not every label these strings reach is one this plugin controls.
      if type == "string" and (. | length) > 0
      then (. | gsub("[<>]"; "") | .[0:$max])
      else null end
      | if . == "" then null else . end;
    def clean_url:
      if type == "string" and test("^https?://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$")
      then . else null end;
    {
      title:      (.title      | clean_text),
      creator:    (.creator    | clean_text),
      license:    (.license    | clean_text),
      licenseUrl: (.licenseUrl | clean_url),
      source:     (.source     | clean_text),
      sourceUrl:  (.sourceUrl  | clean_url)
    }
    | with_entries(select(.value != null))
  ' 2>/dev/null
}

write_meta() {
  local target=$1 url=$2 meta=${3:-}
  local merged
  merged=$(printf '%s' "${meta:-\{\}}" |
    jq -c --arg url "$url" '. + {url: $url}' 2>/dev/null)
  [[ -n $merged ]] || merged=$(jq -cn --arg url "$url" '{url: $url}')
  printf '%s\n' "$merged" >"$target.meta" 2>/dev/null
  # Holds the image URL, which can be presigned; the image itself stays 0644.
  chmod 0600 -- "$target.meta" 2>/dev/null
  return 0
}

# Everything known about an image, as a JSON object. Falls back to the bare
# `.src` sidecar, so an image downloaded before metadata existed still reports
# where it came from.
read_meta() {
  local image=${1:-}
  [[ -n $image ]] || { printf '{}\n'; return 0; }
  if [[ -f $image.meta ]] && jq -e . "$image.meta" >/dev/null 2>&1; then
    jq -c '.' "$image.meta"
    return 0
  fi
  if [[ -f $image.src ]]; then
    jq -cn --arg url "$(head -n1 -- "$image.src" 2>/dev/null)" '{url: $url}'
    return 0
  fi
  printf '{}\n'
}

# Prints the sanitized endpoint answer as one JSON object, `.url` guaranteed.
# Returns 2 when the endpoint named something already disliked, so the caller
# can ask again instead of treating it as an outage.
#
# The whole object rather than just the URL because callers run this in a
# command substitution, and a subshell cannot hand anything back any other way.
resolve_endpoint_meta() {
  local body url meta
  body=$(curl_with_backoff - "$BG_ENDPOINT" trusted "$MAX_JSON_BYTES") || return 1

  url=$(printf '%s' "$body" | jq -er '.url' 2>/dev/null)
  if [[ -z $url || $url == "null" ]]; then
    log "ERROR endpoint response has no usable .url field"
    return 1
  fi
  if ! url_is_safe "$url"; then
    # The URL is not in the message: the endpoint chose it, and it can carry a
    # token of its own.
    log "ERROR refusing an image url that is not a plain http(s) url"
    return 1
  fi
  # The endpoint chose this URL, so it has to point at the public internet and
  # not at something reachable only from here.
  url_is_public "$url" || return 1
  if is_blocked_url "$url"; then
    log "endpoint offered a disliked image again (by url)"
    return 2
  fi

  meta=$(printf '%s' "$body" | sanitize_meta)
  [[ -n $meta ]] || meta="{}"

  printf '%s' "$meta" | jq -c --arg url "$url" '. + {url: $url}'
}

extension_for_mime() {
  case "$1" in
    image/jpeg) printf 'jpg\n' ;;
    image/png) printf 'png\n' ;;
    image/webp) printf 'webp\n' ;;
    image/gif) printf 'gif\n' ;;
    image/bmp | image/x-ms-bmp) printf 'bmp\n' ;;
    *) return 1 ;;
  esac
}

# Downloads $1, validates it really is an image, and prints where it landed.
# $2 is the endpoint's metadata for it, stored beside the file.
# Returns 2 when the bytes turn out to be an image the user has disliked.
download_image() {
  local url=$1 meta=${2:-}
  local tmp="$IMAGE_DIR/.download.$$"
  rm -f -- "$tmp"

  if ! curl_with_backoff "$tmp" "$url"; then
    rm -f -- "$tmp"
    return 1
  fi

  if [[ ! -s $tmp ]]; then
    log "ERROR downloaded file is empty: $url"
    rm -f -- "$tmp"
    return 1
  fi

  # An HTML error page served with a 200 must never become the wallpaper, so
  # trust the content, not the URL or the Content-Type header.
  local mime ext
  mime=$(file --mime-type -b -- "$tmp" 2>/dev/null)
  if ! ext=$(extension_for_mime "$mime"); then
    log "ERROR downloaded content is not a supported image (mime: ${mime:-unknown})"
    rm -f -- "$tmp"
    return 1
  fi

  local sum
  if ! sum=$(image_hash "$tmp"); then
    log "ERROR could not hash the downloaded image"
    rm -f -- "$tmp"
    return 1
  fi

  # Checked before the dedupe branch below, so a disliked image is never
  # brought back to life by an endpoint that keeps offering it.
  if is_blocked_hash "$sum"; then
    log "endpoint offered a disliked image again (by content)"
    rm -f -- "$tmp"
    return 2
  fi

  local short target liked
  short=${sum:0:8}
  target="$IMAGE_DIR/$short.$ext"
  liked="$LIKED_DIR/$short.$ext"

  # An endpoint that repeats itself must not drop a second copy of a kept image
  # next to the kept one, where the panel would stop calling it kept and the
  # next command would delete it as unkept churn.
  if [[ -f $liked ]]; then
    rm -f -- "$tmp"
    write_meta "$liked" "$url" "$meta"
    log "endpoint returned an image you had kept ($short.$ext)"
    printf '%s\n' "$liked"
    return 0
  fi

  if [[ -f $target ]]; then
    # Byte-identical to what is already on screen; keep the file we have.
    rm -f -- "$tmp"
    log "endpoint returned the image already on screen ($short.$ext)"
  else
    mv -f -- "$tmp" "$target" || {
      log "ERROR could not store downloaded image"
      rm -f -- "$tmp"
      return 1
    }
    chmod 0644 -- "$target" 2>/dev/null
    log "downloaded $short.$ext"
  fi

  # Remember where it came from and whatever the endpoint said about it: a
  # later dislike can block the URL too, and the panel has something to credit.
  # Not an image extension, so the sidecar is invisible to every find here.
  write_meta "$target" "$url" "$meta"

  printf '%s\n' "$target"
}

# Prints the path of a freshly fetched image the user has not disliked.
# Returns 2 when every attempt came back blocked — an endpoint that caches its
# answer will do exactly that, and the caller should rotate instead.
fetch_fresh_image() {
  local attempt=1 meta url image rc blocked=0
  while ((attempt <= BG_BLOCKED_RETRIES)); do
    meta=$(resolve_endpoint_meta)
    rc=$?
    if ((rc != 0)); then
      ((rc == 2)) || return 1
      blocked=1
      ((attempt++))
      continue
    fi

    url=$(printf '%s' "$meta" | jq -r '.url // ""')
    if [[ -z $url ]]; then
      log "ERROR endpoint metadata lost its url"
      return 1
    fi

    image=$(download_image "$url" "$meta")
    rc=$?
    if ((rc == 0)); then
      printf '%s\n' "$image"
      return 0
    fi
    ((rc == 2)) || return 1
    blocked=1
    ((attempt++))
  done

  ((blocked)) && return 2
  return 1
}

# ------------------------------------------------------------- subcommands

# Nothing that changes what is on screen runs until the user has said yes. This
# is the whole of that promise: one gate, checked by every such subcommand.
require_enabled() {
  ((BG_ENABLED)) && return 0
  log "turned off (BG_ENABLED=0), leaving the background alone"
  record_result disabled "Turned off — nothing is changing your background"
  return 1
}

cmd_run() {
  require_enabled || return 0

  if [[ -z $BG_ENDPOINT ]]; then
    log "BG_ENDPOINT is not set in $CONFIG_FILE, showing a kept image instead"
    if rotate_liked; then
      record_result rotated "No endpoint set, showing a kept image"
      return 0
    fi
    # Nothing configured and nothing kept: say so on the background itself.
    if show_setup_notice; then
      record_result unconfigured "Set an endpoint to start fetching images"
      return 0
    fi
    record_result failed "No endpoint set and no kept images"
    return 1
  fi

  local image rc
  image=$(fetch_fresh_image)
  rc=$?
  if ((rc == 0)) && apply_background "$image"; then
    record_result fetched "Fetched a new image"
    return 0
  fi

  local reason="the endpoint could not be reached"
  ((rc == 2)) && reason="the endpoint only offered images you disliked"
  log "falling back to the images you kept: $reason"
  if rotate_liked; then
    if ((rc == 2)); then
      record_result rotated "Nothing new at the endpoint, showing a kept image"
    else
      record_result rotated "Endpoint unreachable, showing a kept image"
    fi
    return 0
  fi

  # Nothing to put in its place, so whatever is on screen stays there and the
  # service's backoff tries again later.
  record_result failed "Could not fetch, and you have not kept any images"
  return 1
}

cmd_next() {
  require_enabled || return 0
  if rotate_liked; then
    record_result rotated "Showing the next image you kept"
    return 0
  fi
  if [[ -z $BG_ENDPOINT ]] && show_setup_notice; then
    record_result unconfigured "Set an endpoint to start fetching images"
    return 0
  fi
  record_result failed "You have not kept any images yet"
  return 1
}

cmd_like() {
  require_enabled || return 0
  local current origin
  current=$(current_background)
  if ! origin=$(image_origin "$current"); then
    log "there is no current background to like"
    record_result failed "No background to like"
    return 1
  fi

  case "$origin" in
    liked)
      log "already liked $(basename -- "$current")"
      record_result liked "Already kept"
      return 0
      ;;
    foreign)
      log "the current background did not come from here, nothing to like"
      record_result failed "That wallpaper is not one of ours"
      return 1
      ;;
  esac

  # Before the move, not after: apply_background records the background it
  # found, and by then the symlink points at a file that is no longer there —
  # image_origin cannot recognise a path it cannot stat, so one of our own
  # images would be written down as "the wallpaper from before".
  remember_original_background

  local target="$LIKED_DIR/$(basename -- "$current")"
  mkdir -p "$LIKED_DIR" 2>/dev/null
  if ! mv -f -- "$current" "$target"; then
    log "ERROR could not move $(basename -- "$current") into $LIKED_DIR"
    record_result failed "Could not keep that image"
    return 1
  fi
  [[ -f $current.src ]] && mv -f -- "$current.src" "$target.src"
  [[ -f $current.meta ]] && mv -f -- "$current.meta" "$target.meta"

  # The symlink still points at the old path, so re-apply at the new one.
  if ! apply_background "$target"; then
    record_result failed "Kept the image, but could not re-apply it"
    return 1
  fi

  log "liked $(basename -- "$target")"
  record_result liked "Kept — it stays on disk"
  return 0
}

cmd_dislike() {
  require_enabled || return 0
  local current origin
  current=$(current_background)
  if ! origin=$(image_origin "$current"); then
    log "there is no current background to dislike"
    record_result failed "No background to dislike"
    return 1
  fi
  if [[ $origin == foreign ]]; then
    log "the current background did not come from here, nothing to dislike"
    record_result failed "That wallpaper is not one of ours"
    return 1
  fi

  local sum url=""
  if ! sum=$(image_hash "$current"); then
    log "ERROR could not hash $(basename -- "$current")"
    record_result failed "Could not read that image"
    return 1
  fi
  url=$(read_meta "$current" | jq -r '.url // ""' 2>/dev/null)

  # Blocked first: without this the refetch below would be handed the very
  # same image back and dedupe it into a no-op.
  block_image "$sum" "$url"

  local replacement rc=1 message=""
  if [[ -n $BG_ENDPOINT ]]; then
    replacement=$(fetch_fresh_image)
    rc=$?
    ((rc == 2)) && message="The endpoint only had that same image"
  fi

  if ((rc == 0)) && apply_background "$replacement"; then
    record_result disliked "Removed, and fetched a replacement"
  elif rotate_liked "$current"; then
    : "${message:=Removed, showing a kept image instead}"
    record_result disliked "$message"
  elif show_notice "$(empty_notice_body)"; then
    record_result disliked "Removed — you have not kept any others"
  else
    # Nothing could take its place, so the image stays on screen. Leaving it
    # blocked would mean the blocklist lies about what is showing.
    unblock_image "$sum"
    log "ERROR nothing could replace $(basename -- "$current"); keeping it"
    record_result failed "Nothing to replace it with, so it stays"
    return 1
  fi

  rm -f -- "$current" "$current.src" "$current.meta"
  log "disliked $(basename -- "$current")"
  return 0
}

cmd_restore() {
  local original
  if ! original=$(original_background); then
    if [[ -f $ORIGINAL_FILE ]]; then
      log "the background from before is gone, leaving the current one alone"
      record_result failed "Your original background is no longer on disk"
    else
      log "no earlier background was ever recorded, nothing to restore"
      record_result failed "There is no earlier background to restore"
    fi
    return 1
  fi

  if [[ $original == "$(current_background)" ]]; then
    log "the original background is already in use"
    record_result restored "Your original background is already showing"
    return 0
  fi

  if ! apply_background "$original"; then
    record_result failed "Could not put your original background back"
    return 1
  fi
  log "restored the original background"
  record_result restored "Put your original background back"
  return 0
}

cmd_enable() {
  cmd_set_config BG_ENABLED 1 || return 1
  log "enabled"
  record_result enabled "Turned on"
  return 0
}

# Turning it off is also the undo: the desktop goes back to the wallpaper the
# plugin found. A missing original must not fail the disable, though — the
# setting is what the user asked for, the restore is a courtesy.
cmd_disable() {
  cmd_set_config BG_ENABLED 0 || return 1
  log "disabled"
  if cmd_restore; then
    record_result disabled "Turned off, and put your original background back"
  else
    record_result disabled "Turned off"
  fi
  return 0
}

# The value is $2 when there is one, and otherwise a line on stdin. The panel
# uses the second form: BG_ENDPOINT can carry a token, and an argument is
# visible in /proc/<pid>/cmdline to every local user for as long as the process
# lives. By hand, `set-config KEY VALUE` still works as it always did — and an
# empty endpoint still has to be asked for explicitly, as `set-config
# BG_ENDPOINT ""`, rather than by leaving the argument off.
cmd_set_config() {
  local key=${1:-} value="" known=0 candidate
  if (($# >= 2)); then
    value=$2
  elif [[ -t 0 ]]; then
    log "ERROR no value given for ${key:-<none>}, and stdin is a terminal"
    return 1
  else
    # One line, because config_value_safe refuses a value containing a newline
    # anyway. A value sent without a trailing newline is fine — read reports EOF
    # and still hands it over — but nothing at all is not: blanking the endpoint
    # is asked for as `set-config BG_ENDPOINT ""`, never by saying nothing.
    if ! IFS= read -r value && [[ -z $value ]]; then
      log "ERROR no value for ${key:-<none>} on stdin"
      return 1
    fi
  fi

  for candidate in "${CONFIG_KEYS[@]}"; do
    [[ $candidate == "$key" ]] && known=1 && break
  done
  if ((!known)); then
    log "ERROR refusing to set unknown key: ${key:-<none>}"
    return 1
  fi
  if ! config_value_safe "$value"; then
    log "ERROR refusing an unsafe value for $key"
    return 1
  fi
  if ! config_value_valid "$key" "$value"; then
    log "ERROR invalid value for $key"
    return 1
  fi

  # Still not the worker's lock — editing a setting must not queue behind a
  # download — but the rewrite below reads the whole file and moves a new one
  # over it, so two writers landing together throw one of the changes away.
  # `enable` writing from inside the worker's lock and the panel writing an
  # interval from outside it is exactly that case. Ordering is always this
  # one's after the worker's, so the pair cannot deadlock.
  exec 8>"$CONFIG_LOCK" || {
    log "ERROR cannot open $CONFIG_LOCK"
    return 1
  }
  if ! flock -w 5 8; then
    log "ERROR another config write is in progress, not setting $key"
    return 1
  fi

  [[ -f $CONFIG_FILE ]] || write_default_config

  local tmp="$CONFIG_DIR/.config.env.$$" replaced=0 line
  # The mv below makes this file the config, so it is created with the config's
  # mode rather than the umask's.
  (umask 077; : >"$tmp") 2>/dev/null || {
    log "ERROR cannot write $tmp"
    return 1
  }
  local assignment_re="^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*="
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $assignment_re ]]; then
      ((replaced)) && continue
      printf '%s="%s"\n' "$key" "$value" >>"$tmp"
      replaced=1
    else
      printf '%s\n' "$line" >>"$tmp"
    fi
  done <"$CONFIG_FILE"
  ((replaced)) || printf '%s="%s"\n' "$key" "$value" >>"$tmp"

  if ! mv -f -- "$tmp" "$CONFIG_FILE"; then
    log "ERROR could not update $CONFIG_FILE"
    rm -f -- "$tmp"
    return 1
  fi
  # The value itself is not logged: an endpoint URL can carry a token.
  log "set $key"
  return 0
}

cmd_status() {
  local last_epoch="" last_result="unknown" last_message=""
  if [[ -f $LAST_FILE ]]; then
    IFS=$'\t' read -r last_epoch last_result last_message <"$LAST_FILE"
  fi

  local current origin="none"
  current=$(current_background)
  origin=$(image_origin "$current") || origin="none"

  local original=""
  original=$(original_background) || original=""

  jq -n \
    --arg endpoint "$BG_ENDPOINT" \
    --arg current "$current" \
    --arg origin "$origin" \
    --arg config "$CONFIG_FILE" \
    --arg liked "$LIKED_DIR" \
    --arg lastResult "${last_result:-unknown}" \
    --arg lastMessage "${last_message:-}" \
    --arg lastLog "$(tail -n1 -- "$LOG_FILE" 2>/dev/null)" \
    --arg lastRun "${last_epoch:-}" \
    --argjson interval "$BG_INTERVAL_MINUTES" \
    --argjson likedImages "$(count_files liked_files_sorted)" \
    --argjson blocked "$(blocked_count)" \
    --arg original "$original" \
    --argjson enabled "$( ((BG_ENABLED)) && echo true || echo false)" \
    --argjson meta "$(read_meta "$current")" \
    '{
      endpoint: $endpoint,
      intervalMinutes: $interval,
      likedImages: $likedImages,
      blockedImages: $blocked,
      currentBackground: $current,
      currentOrigin: $origin,
      currentIsOurs: ($origin == "downloaded" or $origin == "liked"),
      currentLiked: ($origin == "liked"),
      currentMeta: $meta,
      enabled: $enabled,
      originalBackground: $original,
      canRestore: ($original != "" and $original != $current),
      lastResult: $lastResult,
      lastMessage: $lastMessage,
      lastLog: $lastLog,
      lastRun: (if $lastRun == "" then null else ($lastRun | tonumber) end),
      configFile: $config,
      likedDir: $liked
    }'
}

# ------------------------------------------------------------------- entry

main() {
  load_config
  rotate_log
  check_dependencies || return 1

  local command=${1:-run}
  case "$command" in
    interval)
      printf '%s\n' "$BG_INTERVAL_MINUTES"
      return 0
      ;;
    status)
      cmd_status
      return 0
      ;;
    set-config)
      # Touches config.env only, never the images, so it must not queue behind
      # a download that can take a minute. The value is forwarded only when one
      # was actually given, so cmd_set_config can tell "no value, read stdin"
      # from an explicitly empty one.
      if (($# >= 3)); then
        cmd_set_config "${2:-}" "$3"
      else
        cmd_set_config "${2:-}"
      fi
      return $?
      ;;
  esac

  # Only the commands that touch the images or the wallpaper need the lock: a
  # timer tick and a manual IPC call must never race each other into it.
  exec 9>"$LOCK_FILE" || {
    log "ERROR cannot open lock file $LOCK_FILE"
    return 1
  }
  if ! flock -n 9; then
    log "another run is in progress, skipping"
    return 0
  fi

  # Under the lock, so it runs once per real run rather than on every status
  # poll, and never while another run's scratch files are live.
  sweep_stale_temp_files

  local rc=0
  case "$command" in
    run) cmd_run ;;
    next | rotate) cmd_next ;;
    like) cmd_like ;;
    dislike) cmd_dislike ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    restore) cmd_restore ;;
    *)
      printf 'Usage: %s [run|next|like|dislike|enable|disable|restore|set-config KEY [VALUE, else read from stdin]|status|interval]\n' \
        "${0##*/}" >&2
      return 2
      ;;
  esac
  rc=$?

  # Whatever just happened, $IMAGE_DIR is left holding at most the image on
  # screen: one call site rather than one per subcommand, and it cannot be
  # forgotten by a path that changed the wallpaper in an unusual way.
  discard_unkept

  return $rc
}

main "$@"
