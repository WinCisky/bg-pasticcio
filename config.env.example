# bg-pasticcio — configuration.
#
# The real file lives at ~/.config/bg-pasticcio/config.env and is
# created automatically with these defaults on the first run. This copy is
# only here for reference; editing it changes nothing.
#
# The panel in the bar edits the real file for you, through
# `bg-pasticcio set-config`. Editing it by hand works just as well.
#
# Changes to BG_ENABLED and BG_INTERVAL_MINUTES are picked up live, without
# restarting the shell or the plugin.

# Whether the plugin may change your background at all. It ships off: nothing
# is touched until you turn this on, from the panel in the bar or with
# `bg-pasticcio enable`. Turning it off again puts your original background
# back, if it is still on disk.
BG_ENABLED=0

# Endpoint returning JSON shaped like {"url": "https://.../image.jpg"}, and
# optionally a title, creator and licence for it.
# Leave empty to rotate only the images you kept.
BG_ENDPOINT="https://bg.ssimo.dev"

# How often to change the background, in minutes.
BG_INTERVAL_MINUTES=60

# Per-request network timeout, in seconds.
BG_TIMEOUT_SECONDS=20

# Attempts per network call before giving up and showing a kept image instead.
BG_MAX_RETRIES=4

# Exponential backoff base: waits BASE, BASE*2, BASE*4 ... between attempts.
BG_RETRY_BASE_SECONDS=2

# How many times to ask the endpoint again when it answers with an image you
# have already disliked. An endpoint that caches its answer will keep handing
# back the same one, so this gives up quickly and shows a kept image instead.
BG_BLOCKED_RETRIES=3
