# Omarchy Background Changer — configuration.
#
# The real file lives at ~/.config/omarchy-bkg-changer/config.env and is
# created automatically with these defaults on the first run. This copy is
# only here for reference; editing it changes nothing.
#
# Changes to BG_INTERVAL_MINUTES are picked up live, without restarting the
# shell or the plugin.

# Endpoint returning JSON shaped like {"url": "https://.../image.jpg"}.
# Leave empty to rotate only the images already downloaded.
BG_ENDPOINT=""

# How often to change the background, in minutes.
BG_INTERVAL_MINUTES=60

# How many downloaded images to keep locally for offline rotation.
BG_KEEP_IMAGES=10

# Per-request network timeout, in seconds.
BG_TIMEOUT_SECONDS=20

# Attempts per network call before giving up and rotating the local pool.
BG_MAX_RETRIES=4

# Exponential backoff base: waits BASE, BASE*2, BASE*4 ... between attempts.
BG_RETRY_BASE_SECONDS=2
